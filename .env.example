# Render Postgres values (copy these from your Render database's Connections page)
SPRING_DATASOURCE_URL=jdbc:postgresql://YOUR_RENDER_DATABASE_HOST:5432/campus_credit_db
SPRING_DATASOURCE_USERNAME=YOUR_RENDER_DATABASE_USER
SPRING_DATASOURCE_PASSWORD=YOUR_RENDER_DATABASE_PASSWORD

# Generate a long random value. Never commit the actual value.
JWT_SECRET=replace-with-a-long-random-secret

# The exact address where the frontend is served. For local testing use http://localhost:5175.
CORS_ALLOWED_ORIGINS=http://localhost:5175
COOKIE_SECURE=true
COOKIE_SAME_SITE=None

# Required for transfer idempotency and rate limiting.
SPRING_REDIS_HOST=YOUR_REDIS_HOST
SPRING_REDIS_PORT=6379

# Required for notification delivery.
SPRING_RABBITMQ_HOST=YOUR_RABBITMQ_HOST
SPRING_RABBITMQ_PORT=5672
SPRING_RABBITMQ_USERNAME=YOUR_RABBITMQ_USERNAME
SPRING_RABBITMQ_PASSWORD=YOUR_RABBITMQ_PASSWORD
